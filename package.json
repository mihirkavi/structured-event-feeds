{
  "name": "structured-event-feeds",
  "version": "0.1.1",
  "description": "Read public events from iCalendar feeds and schema.org Event data (Meetup, Eventbrite, university and organization calendars), normalized to an open event record. Library plus MCP server.",
  "license": "MIT",
  "author": "Mihir Kavishwar",
  "repository": { "type": "git", "url": "git+https://github.com/mihirkavi/structured-event-feeds.git" },
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" }
  },
  "bin": { "structured-event-feeds-mcp": "./src/mcp.ts" },
  "files": ["src", "README.md", "LICENSE"],
  "keywords": ["icalendar", "ics", "schema-org", "json-ld", "meetup", "eventbrite", "events", "event-discovery", "mcp", "model-context-protocol", "ai-agents"],
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "mcp": "tsx src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": { "optional": true },
    "zod": { "optional": true }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.6",
    "typescript": "~5.9.3",
    "zod": "^4.3.6"
  }
}
